generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int          @id @default(autoincrement())
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")
  firstName               String
  lastName                String
  phoneNumber             String       @unique
  avatarPath              String?
  email                   String       @unique
  password                String
  isAdmin                 Boolean      @default(false) @map("is_admin")
  isActivated             Boolean      @default(false) @map("is_activated")
  activationLink          String?      @unique @map("activation_link")
  resetPasswordToken      String?      @map("reset_password_token")
  resetPasswordExpiration DateTime?    @map("reset_password_expiration")
  chatsWithAI             ChatWithAI[]
}

model CreatorMode {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      String
  // courses   Course[]
  // lessons   Lesson[]
}

model ChatWithAI {
  id       Int             @id @default(autoincrement())
  title    String          @default("New chat")
  userId   Int
  user     User            @relation(fields: [userId], references: [id])
  messages MessageWIthAI[]
}

model MessageWIthAI {
  id           Int               @id @default(autoincrement())
  text         String
  file         String?
  type         MessageWIthAIType @default(TEXT)
  from         MessageWIthAIFrom @default(USER)
  chatWithAI   ChatWithAI?       @relation(fields: [chatWithAIId], references: [id])
  chatWithAIId Int               @map("chat_with_ai_id")
}

enum UserMode {
  STUDENT
  CREATOR
}

enum MessageWIthAIFrom {
  AI
  USER
}

enum MessageWIthAIType {
  VOICE
  TEXT
}

