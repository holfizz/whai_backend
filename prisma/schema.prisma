//=============== Prisma Client Configuration ===============//
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//=========================== Enums ==========================//

// TIME ICON TYPE

enum CourseLevelEnum {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserRole {
  ADMIN
  USER
  STUDENT
  CREATOR
}

enum MessageWithAIRole {
  ASSISTANT
  USER
}

enum MessageType {
  VOICE
  TEXT
}

enum MessageTypeWithAI {
  answer
  function_cal
  tool_response
  follow_up
}

enum LessonTypeEnum {
  VIDEO
}

enum LessonBlockEnum {
  TEXT
  VIDEO
  IMAGE
  CODE
}

enum QuizQuestionType {
  MCQ
  MRQ
  OEQ
  NRQ
  CLOZE
  MATCH
}

enum InteractionType {
  MATCHING
}

//=========================== User Models ==========================//

model User {
  id                      String            @id @default(uuid())
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  firstName               String            @map("first_name")
  lastName                String            @map("last_name")
  phoneNumber             String            @unique @map("phone_number")
  avatarPath              String?           @map("avatar_path")
  email                   String            @unique
  password                String
  roles                   UserRole[]        @default([USER, STUDENT])
  isVerified              Boolean           @default(false) @map("is_verified")
  activationLink          String?           @unique @map("activation_link")
  resetPasswordToken      String?           @map("reset_password_token")
  resetPasswordExpiration DateTime?         @map("reset_password_expiration")
  courseId                String?           @map("course_id")
  chat                    Chat[]
  chatMembers             ChatMembers[]
  chatsWithAI             ChatWithAI[]
  message                 Message[]
  course                  Course?           @relation(fields: [courseId], references: [id])
  learningSession         LearningSession[]
  telegramLink            TelegramLink?
  isTelegramLinked        Boolean?          @default(false) @map("is_telegram_linked")
  telegramId              String?           @unique @map("telegram_id")
  notice                  Notice[]
  sentNotices             Notice[]          @relation(name: "NoticeSender")
  quizResult              QuizResult[]

  @@map("users")
}

model TelegramLink {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("telegram_links")
}

//=========================== Chat Models ==========================//

model ChatWithAI {
  id        String          @id @unique @default(uuid())
  title     String          @default("New chat with ai")
  userId    String?         @map("user_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User?           @relation(fields: [userId], references: [id])
  messages  MessageWithAI[]

  @@map("chats_with_ai")
}

model MessageWithAI {
  id           String             @id @default(uuid())
  file         String?
  type         MessageTypeWithAI? @default(answer)
  content      String
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  role         MessageWithAIRole  @default(USER)
  chatWithAI   ChatWithAI?        @relation(fields: [chatWithAIId], references: [id])
  chatWithAIId String?            @map("chat_with_ai_id")

  @@map("messages_with_ai")
}

model Chat {
  id        String   @id @default(uuid())
  title     String   @default("New chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ownerId   String   @map("owner_id")

  inviteLink  String?       @unique @map("invite_link")
  owner       User          @relation(fields: [ownerId], references: [id])
  chatMembers ChatMembers[]
  messages    Message[]

  @@map("chats")
}

model ChatMembers {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  chatId    String    @map("chat_id")
  chat      Chat      @relation(fields: [chatId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  message   Message[] @relation("ChatMembersToMessage")

  @@map("chat_members")
}

model Message {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  type        MessageType   @default(TEXT)
  text        String
  file        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  chatId      String?       @map("chat_id")
  chat        Chat?         @relation(fields: [chatId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  chatMembers ChatMembers[] @relation("ChatMembersToMessage")

  @@map("messages")
}

//=========================== Lesson Models ==========================//

model LessonBlock {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  type      LessonBlockEnum @default(TEXT)
  code      String?
  text      String?
  videoUrl  String?         @map("video_url")
  imageUrl  String?         @map("image_url")
  caption   String?
  lessonId  String          @map("lesson_id")
  lesson    Lesson          @relation(fields: [lessonId], references: [id])

  @@map("lesson_blocks")
}

model LessonTask {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      String
  isChecked Boolean  @default(false) @map("is_checked")
  lessonId  String   @map("lesson_id")
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  @@map("lesson_tasks")
}

model Lesson {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  name           String
  description    String?
  types          LessonTypeEnum[]
  lessonBlocks   LessonBlock[]
  lessonTasks    LessonTask[]
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id])
  isCompleted    Boolean          @default(false) @map("is_completed")
  subtopic       Subtopic?        @relation(fields: [subtopicId], references: [id])
  subtopicId     String           @map("subtopic_id")
  quizResult     QuizResult[]
  completionTime Int              @default(0) @map("completion_time")

  @@map("lessons")
}

//=========================== Subtopic / Models ==========================//

model Subtopic {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  name        String
  description String?
  quizzes     Quiz[]
  lessons     Lesson[]
  quizResult  QuizResult[]
  topic       Topic?       @relation(fields: [topicId], references: [id])
  topicId     String

  @@map("subtopics")
}

model Topic {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  name        String
  description String?
  courseId    String     @map("course_id")
  course      Course     @relation(fields: [courseId], references: [id])
  subtopics   Subtopic[]

  @@map("topics")
}

//=========================== Course Models ==========================//

model Course {
  id          String           @id @default(uuid())
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  name        String
  description String?
  ownerID     String           @map("owner_id")
  publicUrl   String?          @map("public_url")
  tags        String[]
  level       CourseLevelEnum?
  students    User[]
  teacherIds  String[]         @map("teacher_ids")
  studentsId  String[]         @map("students_id")
  quizResult  QuizResult[]
  lessons     Lesson[]
  quizzes     Quiz[]
  topics      Topic[]

  @@map("courses")
}

//=========================== Quiz Models ==========================//

model Quiz {
  id             String       @id @default(uuid())
  name           String
  description    String?
  questions      Question[] // Связь с вопросами
  totalQuestions Int?         @default(0) @map("total_questions")
  subtopicId     String?      @map("subtopic_id")
  folder         Subtopic?    @relation(fields: [subtopicId], references: [id])
  quizResult     QuizResult[]
  courseId       String
  course         Course?      @relation(fields: [courseId], references: [id])
  isCompleted    Boolean      @default(false) @map("is_completed")
  completionTime Int          @default(0) @map("completion_time")
  isPlan         Boolean      @default(false)

  @@map("quizzes")
}

model Question {
  id                  String               @id @default(uuid())
  questionType        QuizQuestionType     @map("question_type")
  stimulus            String?
  prompt              String?
  choices             Choice[]
  answers             String[]
  quiz                Quiz                 @relation(fields: [quizId], references: [id])
  quizId              String               @map("quiz_id")
  matchingInteraction MatchingInteraction?
  interactions        Interaction[]
  UserAnswer          UserAnswer[]

  @@map("questions")
}

model Choice {
  id                         String       @id @default(uuid())
  content                    String
  correctAnswerDescription   String?      @map("correct_answer_description")
  incorrectAnswerDescription String?      @map("incorrect_answer_description")
  question                   Question     @relation(fields: [questionId], references: [id])
  questionId                 String       @map("question_id")
  interaction                Interaction? @relation(fields: [interactionId], references: [id])
  interactionId              String?      @map("interaction_id")

  @@map("choices")
}

model Interaction {
  id         String    @id @default(uuid())
  choices    Choice[]
  answers    String[]
  question   Question? @relation(fields: [questionId], references: [id])
  questionId String?   @map("question_id")

  @@map("interactions")
}

model MatchingInteraction {
  id         String   @id @default(uuid())
  left       Json
  right      Json
  answers    Json
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @unique @map("question_id")

  @@map("matching_interactions")
}

model QuizResult {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  quizId         String       @map("quiz_id")
  courseId       String       @map("course_id")
  lessonId       String?      @map("lesson_id")
  subtopicId     String?      @map("subtopic_id")
  totalQuestions Int          @map("total_questions")
  correctAnswers Int          @map("correct_answers")
  wrongAnswers   Int          @map("wrong_answers")
  completionTime Int          @map("completion_time")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User?        @relation(fields: [userId], references: [id])
  quiz           Quiz?        @relation(fields: [quizId], references: [id])
  course         Course?      @relation(fields: [courseId], references: [id])
  userAnswers    UserAnswer[]
  lesson         Lesson?      @relation(fields: [lessonId], references: [id])
  subtopic       Subtopic?    @relation(fields: [subtopicId], references: [id])

  @@map("quiz_results")
}

model UserAnswer {
  id             String      @id @default(uuid())
  quizResultId   String      @map("quiz_result_id")
  questionId     String      @map("question_id")
  selectedAnswer String[]    @map("selected_answer")
  isCorrect      Boolean     @map("is_correct")
  quizResult     QuizResult? @relation(fields: [quizResultId], references: [id])
  question       Question?   @relation(fields: [questionId], references: [id])

  @@map("user_answers")
}

//=========================== Analytics Models ==========================//

model LearningSession {
  id             String @id @default(uuid())
  User           User   @relation(fields: [userId], references: [id])
  userId         String @map("user_id")
  sessionDetails Json   @default("[]") @map("session_details")

  @@map("learning_sessions")
}

//=========================== Notice Models ==========================//

model Notice {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  userId      String   @map("user_id")
  telegramId  String?  @map("telegram_id")
  title       String
  description String?
  readStatus  Boolean  @default(false) @map("read_status")
  user        User     @relation(fields: [userId], references: [id])
  senderId    String?  @map("sender_id")
  sender      User?    @relation(name: "NoticeSender", fields: [senderId], references: [id])

  @@map("notices")
}
