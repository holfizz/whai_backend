generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String        @id @default(uuid())
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  firstName               String
  lastName                String
  phoneNumber             String        @unique
  avatarPath              String?
  email                   String        @unique
  password                String
  roles                   UserRole[]    @default([USER, STUDENT])
  isVerified              Boolean       @default(false) @map("is_verified")
  activationLink          String?       @unique @map("activation_link")
  resetPasswordToken      String?       @map("reset_password_token")
  resetPasswordExpiration DateTime?     @map("reset_password_expiration")
  chatsWithAI             ChatWithAI[]
  message                 Message[]
  chat                    Chat[]
  ChatMembers             ChatMembers[]
  Course                  Course?       @relation(fields: [courseId], references: [id])
  courseId                String?
}

model ChatWithAI {
  id       String          @id @default(uuid())
  title    String          @default("New chat with ai")
  userId   String?         @map("user_id")
  user     User?           @relation(fields: [userId], references: [id])
  messages MessageWithAI[]
}

model MessageWithAI {
  id           String             @id @default(uuid())
  content      String
  file         String?
  type         MessageTypeWithAI?
  role         MessageWithAIRole  @default(USER)
  chatWithAI   ChatWithAI?        @relation(fields: [chatWithAIId], references: [id])
  chatWithAIId String             @map("chat_with_ai_id")
}

model Chat {
  id          String        @id @default(uuid())
  title       String        @default("New chat")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User?         @relation(fields: [ownerId], references: [id])
  ownerId     String
  messages    Message[]
  chatMembers ChatMembers[]
  inviteLink  String?       @unique
}

model ChatMembers {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  chatId    String    @map("chat_id")
  message   Message[]

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Message {
  id          String        @id @default(uuid())
  user        User?         @relation(fields: [userId], references: [id])
  userId      String        @map("user_id")
  type        MessageType   @default(TEXT)
  text        String
  file        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  chat        Chat?         @relation(fields: [chatId], references: [id])
  chatId      String?       @map("chat_id")
  chatMembers ChatMembers[]
}

model LessonBlock {
  id       String          @id @default(uuid())
  type     LessonBlockEnum
  code     String? // Code content for CODE type blocks
  text     String? // Text content for TEXT type blocks
  videoUrl String? // URL for VIDEO type blocks
  imageUrl String? // URL for IMAGE type blocks
  document String? // Path or identifier for DOCUMENT type blocks
  lesson   Lesson          @relation(fields: [lessonId], references: [id])
  duration Int?
  caption  String
  language String?
  lessonId String
  quizId   String?
  quiz     Quiz?           @relation(fields: [quizId], references: [id])
}

model Quiz {
  id          String        @id @default(uuid())
  name        String
  description String?
  questions   Json
  lessonBlock LessonBlock[]
}

model LessonTask {
  id        String  @id @default(uuid())
  name      String
  isChecked Boolean
  lesson    Lesson? @relation(fields: [lessonId], references: [id])
  lessonId  String?
}

model Lesson {
  id           String           @id @default(uuid())
  name         String
  description  String?
  types        LessonTypeEnum[]
  tasks        LessonTask[]
  lessonBlocks LessonBlock[]
  folder       Folder           @relation(fields: [folderId], references: [id])
  folderId     String
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
}

model ProgressPercents {
  id               String   @id @default(uuid())
  completedLessons Int
  courseId         String   @unique
  progressPercents Float
  totalLessons     Int
  Course           Course[]
}

model Course {
  id          String           @id @default(uuid())
  name        String
  description String?
  ownerID     String
  students    User[]
  imageUrl    String?
  publicUrl   String?
  tags        String[]
  level       CourseLevelEnum?

  folders            Folder[]
  progressPercents   ProgressPercents? @relation(fields: [progressPercentsId], references: [id])
  progressPercentsId String?
}

enum CourseLevelEnum {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserRole {
  ADMIN
  USER
  STUDENT
  CREATOR
}

enum MessageWithAIRole {
  ASSISTANT
  USER
}

enum MessageType {
  VOICE
  TEXT
}

enum MessageTypeWithAI {
  answer
  function_cal
  tool_response
  follow_up
}

enum LessonTypeEnum {
  TEXT
  VIDEO
  QUIZ
  DOCUMENT
}

enum LessonBlockEnum {
  TEXT
  VIDEO
  QUIZ
  DOCUMENT
  IMAGE
  CODE
}

