generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String        @id @default(uuid())
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  firstName               String
  lastName                String
  phoneNumber             String        @unique
  avatarPath              String?
  email                   String        @unique
  password                String
  roles                   UserRole[]    @default([USER, STUDENT])
  isVerified              Boolean       @default(false) @map("is_verified")
  activationLink          String?       @unique @map("activation_link")
  resetPasswordToken      String?       @map("reset_password_token")
  resetPasswordExpiration DateTime?     @map("reset_password_expiration")
  chatsWithAI             ChatWithAI[]
  message                 Message[]
  chat                    Chat[]
  ChatMembers             ChatMembers[]
}

model ChatWithAI {
  id       String          @id @default(uuid())
  title    String          @default("New chat with ai")
  userId   String?         @map("user_id")
  user     User?           @relation(fields: [userId], references: [id])
  messages MessageWithAI[]
}

model MessageWithAI {
  id           String            @id @default(uuid())
  text         String
  file         String?
  type         MessageType       @default(TEXT)
  from         MessageWithAIFrom @default(USER)
  chatWithAI   ChatWithAI?       @relation(fields: [chatWithAIId], references: [id])
  chatWithAIId String            @map("chat_with_ai_id")
}

model Chat {
  id          String        @id @default(uuid())
  title       String        @default("New chat")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User?         @relation(fields: [ownerId], references: [id])
  ownerId     String
  messages    Message[]
  chatMembers ChatMembers[]
  inviteLink  String?       @unique
}

model ChatMembers {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  chatId    String    @map("chat_id")
  message   Message[]

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Message {
  id          String        @id @default(uuid())
  user        User?         @relation(fields: [userId], references: [id])
  userId      String        @map("user_id")
  type        MessageType   @default(TEXT)
  text        String
  file        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  chat        Chat?         @relation(fields: [chatId], references: [id])
  chatId      String?       @map("chat_id")
  chatMembers ChatMembers[]
}

enum UserRole {
  ADMIN
  USER
  STUDENT
  CREATOR
}

enum MessageWithAIFrom {
  AI
  USER
}

enum MessageType {
  VOICE
  TEXT
}

