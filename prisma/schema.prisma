generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String        @id @default(uuid())
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  firstName               String
  lastName                String
  phoneNumber             String        @unique
  avatarPath              String?
  email                   String        @unique
  password                String
  roles                   UserRole[]    @default([USER, STUDENT])
  isVerified              Boolean       @default(false) @map("is_verified")
  activationLink          String?       @unique @map("activation_link")
  resetPasswordToken      String?       @map("reset_password_token")
  resetPasswordExpiration DateTime?     @map("reset_password_expiration")
  courseId                String?
  chat                    Chat[]
  ChatMembers             ChatMembers[]
  chatsWithAI             ChatWithAI[]
  message                 Message[]
  Course                  Course?       @relation(fields: [courseId], references: [id])
}

model ChatWithAI {
  id       String          @id @unique() @default(uuid())
  title    String          @default("New chat with ai")
  userId   String?         @map("user_id")
  user     User?           @relation(fields: [userId], references: [id])
  messages MessageWithAI[]
}

model MessageWithAI {
  id           String             @id @default(uuid())
  file         String?
  type         MessageTypeWithAI? @default(answer)
  content      String
  role         MessageWithAIRole  @default(USER)
  ChatWithAI   ChatWithAI?        @relation(fields: [chatWithAIId], references: [id])
  chatWithAIId String?            @map("chat_with_ai_id")
}

model Chat {
  id          String        @id @default(uuid())
  title       String        @default("New chat")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  ownerId     String
  inviteLink  String?       @unique
  owner       User          @relation(fields: [ownerId], references: [id])
  chatMembers ChatMembers[]
  messages    Message[]
}

model ChatMembers {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  chatId    String    @map("chat_id")
  chat      Chat      @relation(fields: [chatId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  message   Message[] @relation("ChatMembersToMessage")
}

model Message {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  type        MessageType   @default(TEXT)
  text        String
  file        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  chatId      String?       @map("chat_id")
  chat        Chat?         @relation(fields: [chatId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  chatMembers ChatMembers[] @relation("ChatMembersToMessage")
}

model LessonBlock {
  id       String          @id @default(uuid())
  type     LessonBlockEnum
  code     String?
  text     String?
  videoUrl String?
  imageUrl String?
  document String?
  duration Int?
  caption  String
  language String?
  lessonId String
  quizId   String?
  lesson   Lesson          @relation(fields: [lessonId], references: [id])
  quiz     Quiz?           @relation(fields: [quizId], references: [id])
}

model Quiz {
  id          String        @id @default(uuid())
  name        String
  description String?
  questions   Json
  lessonBlock LessonBlock[]
}

model LessonTask {
  id        String  @id @default(uuid())
  name      String
  isChecked Boolean
  lessonId  String?
  lesson    Lesson? @relation(fields: [lessonId], references: [id])
}

model Lesson {
  id           String           @id @default(uuid())
  name         String
  description  String?
  types        LessonTypeEnum[]
  folderId     String
  folder       Folder           @relation(fields: [folderId], references: [id])
  lessonBlocks LessonBlock[]
  tasks        LessonTask[]
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model ProgressPercents {
  id               String   @id @default(uuid())
  completedLessons Int
  courseId         String   @unique
  progressPercents Float
  totalLessons     Int
  Course           Course[]
}

model Course {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  ownerID            String
  imageUrl           String?
  publicUrl          String?
  tags               String[]
  level              CourseLevelEnum?
  progressPercentsId String?
  progressPercents   ProgressPercents? @relation(fields: [progressPercentsId], references: [id])
  folders            Folder[]
  students           User[]
}

enum CourseLevelEnum {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserRole {
  ADMIN
  USER
  STUDENT
  CREATOR
}

enum MessageWithAIRole {
  ASSISTANT
  USER
}

enum MessageType {
  VOICE
  TEXT
}

enum MessageTypeWithAI {
  answer
  function_cal
  tool_response
  follow_up
}

enum LessonTypeEnum {
  TEXT
  VIDEO
  QUIZ
  DOCUMENT
}

enum LessonBlockEnum {
  TEXT
  VIDEO
  QUIZ
  DOCUMENT
  IMAGE
  CODE
}
