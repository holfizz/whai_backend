// Enums
enum QuizQuestionType {
  MCQ
  MRQ
  CLOZE
  MATCH
}

enum InteractionType {
  MATCHING
}

// Models
model Quiz {
  id             String       @id @unique @default(uuid())
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  name           String
  description    String?
  questions      Question[]
  totalQuestions Int?         @default(0) @map("total_questions")
  subtopicId     String?      @map("subtopic_id")
  subtopic       Subtopic?    @relation(fields: [subtopicId], references: [id])
  quizResult     QuizResult[]
  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id])
  isCompleted    Boolean      @default(false) @map("is_completed")
  isPlan         Boolean      @default(false)
  User           User?        @relation(fields: [userId], references: [id])
  userId         String?
  isAdditional   Boolean      @default(false) @map("is_additional")

  @@map("quizzes")
}

model UserAnswer {
  id                    String     @id @default(uuid())
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  quizResultId          String
  quizResult            QuizResult @relation(fields: [quizResultId], references: [id])
  questionId            String
  question              Question   @relation(fields: [questionId], references: [id])
  selectedAnswers       String[]
  matchingAnswers       Json       @default("[]")
  correctnessPercentage Float
  correctAnswers        String[]
}

model QuizResult {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id])
  courseId      String?
  course        Course?      @relation(fields: [courseId], references: [id])
  subtopicId    String?
  subtopic      Subtopic?    @relation(fields: [subtopicId], references: [id])
  totalPercents Float        @default(0)
  userAnswers   UserAnswer[]
}

model Question {
  id                  String               @id @unique @default(uuid())
  questionType        QuizQuestionType     @map("question_type")
  prompt              String?
  choices             Choice[]
  answers             String[]
  quiz                Quiz                 @relation(fields: [quizId], references: [id])
  quizId              String               @map("quiz_id")
  matchingInteraction MatchingInteraction?
  UserAnswer          UserAnswer[]

  @@map("questions")
}

model Choice {
  id                         String   @id @unique @default(uuid())
  content                    String
  correctAnswerDescription   String?  @map("correct_answer_description")
  incorrectAnswerDescription String?  @map("incorrect_answer_description")
  question                   Question @relation(fields: [questionId], references: [id])
  questionId                 String   @map("question_id")

  @@map("choices")
}

model MatchingInteraction {
  id         String   @id @unique @default(uuid())
  left       Json
  right      Json
  answers    Json
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @unique @map("question_id")

  @@map("matching_interactions")
}
