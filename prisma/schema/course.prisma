enum CourseLevelEnum {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Course {
  id                 String           @id @unique @default(uuid())
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  name               String           @default("Course")
  description        String?
  ownerID            String           @map("owner_id")
  publicUrl          String?          @map("public_url")
  isPublic           Boolean?         @map("is_public")
  tags               String[]
  level              CourseLevelEnum?
  quizResult         QuizResult[]
  lessons            Lesson[]
  quizzes            Quiz[]
  topics             Topic[]
  Subtopic           Subtopic[]
  courseAIHistory    CourseAIHistory?
  Analytics          Analytics?
  imgUrl             String?
  isHasVideo         Boolean          @default(false)
  isHasAISearchImage Boolean          @default(false)
  needHomeworks      Boolean          @default(false)
  User               User[]

  @@map("courses")
}
