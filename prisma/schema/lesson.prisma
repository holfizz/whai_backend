enum LessonTypeEnum {
  VIDEO
}

enum LessonBlockEnum {
  TEXT
  VIDEO
  IMAGE
  CODE
}

enum ResponseStatus {
  START
  IN_PROGRESS
  COMPLETED
}

model LessonBlock {
  id        String          @id @unique @default(uuid())
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  type      LessonBlockEnum @default(TEXT)
  code      String?
  text      String?
  videoUrl  String?         @map("video_url")
  imageUrl  String?         @map("image_url")
  caption   String?
  lessonId  String          @map("lesson_id")
  lesson    Lesson          @relation(fields: [lessonId], references: [id])

  @@map("lesson_blocks")
}

model InteractionHistory {
  id         String         @id @unique @default(uuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id])
  lessonId   String?        @map("lesson_id")
  lessonTask LessonTask?    @relation(fields: [lessonId], references: [id])
  fileUrl    String         @map("file_url")
  title      String?        @map("title")
  response   Response       @relation(fields: [responseId], references: [id])
  status     ResponseStatus @default(START)
  message    String?
  responseId String         @unique

  @@map("interaction_history")
}

model Response {
  id                   String              @id @unique @default(uuid())
  interactionHistory   InteractionHistory?
  status               ResponseStatus
  reason               String?
  links                String[]
  incorrectParts       String
  suggestions          String
  completionPercentage Int
}

model LessonTask {
  id                 String               @id @unique @default(uuid())
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  name               String
  description        String?
  isChecked          Boolean              @default(false) @map("is_checked")
  lessonId           String               @map("lesson_id")
  lesson             Lesson               @relation(fields: [lessonId], references: [id])
  InteractionHistory InteractionHistory[]

  @@map("lesson_tasks")
}

model Lesson {
  id           String           @id @unique @default(uuid())
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  name         String
  description  String?
  types        LessonTypeEnum[]
  lessonBlocks LessonBlock[]
  lessonTasks  LessonTask[]
  courseId     String?
  course       Course?          @relation(fields: [courseId], references: [id])
  isCompleted  Boolean          @default(false) @map("is_completed")
  subtopic     Subtopic?        @relation(fields: [subtopicId], references: [id])
  subtopicId   String?          @map("subtopic_id")
  User         User?            @relation(fields: [userId], references: [id])
  userId       String?
  isAdditional Boolean          @default(false) @map("is_additional")

  @@map("lessons")
}
