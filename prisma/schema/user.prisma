// Enums

enum UserRole {
  ADMIN
  USER
  STUDENT
  CREATOR
}

model User {
  id                      String            @id @unique @default(uuid())
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  firstName               String            @map("first_name")
  lastName                String            @map("last_name")
  phoneNumber             String            @map("phone_number")
  avatarPath              String?           @map("avatar_path")
  email                   String            @unique
  password                String
  roles                   UserRole[]        @default([USER, STUDENT])
  isVerified              Boolean           @default(false) @map("is_verified")
  activationLink          String?           @unique @map("activation_link")
  resetPasswordToken      String?           @map("reset_password_token")
  resetPasswordExpiration DateTime?         @map("reset_password_expiration")
  courseId                String?           @map("course_id")
  chat                    Chat[]
  chatMembers             ChatMembers[]
  chatsWithAI             ChatWithAI[]
  message                 Message[]
  course                  Course[]
  learningSession         LearningSession[]
  telegramLink            TelegramLink?
  isTelegramLinked        Boolean?          @default(false) @map("is_telegram_linked")
  telegramId              String?           @unique @map("telegram_id")
  notice                  Notice[]
  sentNotices             Notice[]          @relation(name: "NoticeSender")
  quizResult              QuizResult[]
  courseAIHistory         CourseAIHistory[]
  Analytics               Analytics?

  currentSubscriptionType SubscriptionType?     @unique @map("current_subscription_type")
  subscriptionHistory     SubscriptionHistory[]

  quizzes             Quiz[]
  lessons             Lesson[]
  isAutoRenewal       Boolean       @default(false) @map("is_auto_renewal")
  currentSubscription Subscription? @relation(fields: [currentSubscriptionType], references: [type])
  Transaction         Transaction[]

  currentCourseCount    Int @default(0) @map("current_course_count")
  currentLessonCount    Int @default(0) @map("current_lesson_count")
  additionalTitlesCount Int @default(0) @map("additional_titles_count")

  isTrial     Boolean   @default(false) @map("is_trial")
  trialEndsAt DateTime? @map("trial_ends_at")
  isTrialUsed Boolean   @default(false) @map("is_trial_used")

  isFirstCourseCompleted Boolean @default(false) @map("is_first_course_completed")
  isHomeworkCompleted    Boolean @default(false) @map("is_homework_completed")
  isQuizCompleted        Boolean @default(false) @map("is_quiz_completed")
  isFirstLessonCompleted Boolean @default(false) @map("is_first_lesson_completed")

  InteractionHistory InteractionHistory[]

  referralCode   String?          @unique @map("referral_code")
  ReferralIncome ReferralIncome[]

  @@map("users")
}
